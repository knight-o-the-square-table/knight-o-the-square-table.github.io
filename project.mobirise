        "display5Font": "M PLUS Rounded 1c",
        "display5Size": "1.8",
        "display7Font": "Lexend",
        "display7Size": "1",
        "display4Font": "Rubik",
        "display4Size": "2",
        "isRoundedButtons": false,
        "isAnimatedOnScroll": true,
        "isScrollToTopButton": false
      },
